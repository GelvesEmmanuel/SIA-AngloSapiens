{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext", // 👈 Cambiado de CommonJS a NodeNext
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}